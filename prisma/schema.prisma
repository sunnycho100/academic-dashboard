// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id     String @id @default(uuid())
  userId String
  name   String
  color  String
  order  Int    @default(0)

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Task {
  id                String   @id @default(uuid())
  userId            String
  title             String
  type              String   // Lecture, Discussion, Lab, Assignment, Exam Prep
  dueAt             DateTime?
  status            String   @default("todo") // todo | done
  priorityOrder     Int      @default(0)
  notes             String?
  estimatedDuration Int?     // in minutes
  actualTimeSpent   Int?     // in minutes

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  weeklyPlanEntries WeeklyPlanEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([categoryId])
  @@index([status])
  @@index([dueAt])
}

model CompletedTask {
  id                String   @id @default(uuid())
  userId            String
  taskTitle         String
  categoryName      String
  categoryColor     String
  taskType          String
  dueAt             DateTime?
  completedAt       DateTime @default(now())
  actualTimeSpent   Int?     // in minutes
  estimatedDuration Int?     // in minutes
  timeDifference    Int?     // estimated - actual (positive = saved, negative = over)
  notes             String?
  deletedAt         DateTime? // soft delete timestamp
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([completedAt])
  @@index([categoryName])
  @@index([taskType])
  @@index([deletedAt])
}

model TimeRecord {
  id            String   @id @default(uuid())
  userId        String
  taskId        String?  // nullable — task may have been deleted
  taskTitle     String
  categoryName  String
  categoryColor String
  taskType      String
  startTime     DateTime
  endTime       DateTime
  duration      Int      // in seconds
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([startTime])
  @@index([taskId])
}

model WeeklyPlanEntry {
  id     String   @id @default(uuid())
  userId String
  taskId String
  task   Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  date   DateTime // the calendar date this task is planned for

  createdAt DateTime @default(now())

  @@unique([taskId, date])
  @@index([userId])
  @@index([date])
}

model UserInfo {
  id        String   @id @default(uuid())
  userId    String
  name      String   @default("User")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId])
  @@index([userId])
}

model TimetableEntry {
  id              String   @id @default(uuid())
  userId          String
  date            String
  order           Int      @default(0)
  plannedStart    String
  plannedEnd      String
  expectedMinutes Int
  activityName    String
  actualStart     String?
  actualEnd       String?
  actualMinutes   Int?
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([date])
}
